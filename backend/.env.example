ROADWATCH_ENV=development
ROADWATCH_DB_PATH=data/roadwatch.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional hosted PostgreSQL. If set, this takes precedence over ROADWATCH_DB_PATH.
# DATABASE_URL=postgresql://user:password@host:5432/roadwatch
# Optional hosted photo storage. Configure all three values together.
# Create a private bucket in Supabase Storage. Keep the service-role key server-side.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=roadwatch-reports
# Used only for device ingestion. Generate a long random value and configure the same
# value in the ESP32's local firmware/include/secrets.h file.
# ROADWATCH_DEVICE_TOKEN=
# ROADWATCH_UPLOAD_DIR=data/uploads
